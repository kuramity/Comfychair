<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to access the internet for ComfyUI API communication -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 内置更新模块（v4.6.0）：拉起系统安装器（用户确认，无静默安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 更新下载的后台保活：WorkManager 前台服务（API 34+ 需声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 下载完成通知（Android 13+ 运行时权限；被拒时静默跳过，弹窗仍是主入口） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.ComfyChair">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ComfyChair.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- MainContainerActivity - Container for fragments with persistent navigation -->
        <activity
            android:name=".MainContainerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- SettingsContainerActivity - Container for settings fragments -->
        <activity
            android:name=".SettingsContainerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- GalleryContainerActivity - Container for gallery screen -->
        <activity
            android:name=".GalleryContainerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- MediaViewerActivity - Fullscreen media viewer -->
        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ComfyChair.Fullscreen" />

        <!-- MaskEditorActivity - Fullscreen inpainting mask editor -->
        <activity
            android:name=".MaskEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ComfyChair.Fullscreen" />

        <!-- WorkflowEditorActivity - Workflow graph editor -->
        <activity
            android:name=".WorkflowEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- BrowserAuthActivity - WebView for browser-based SSO authentication -->
        <activity
            android:name=".BrowserAuthActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 内置更新模块（v4.7.1）：WorkManager 前台服务承载长时间下载。
             Android 14+ 要求显式声明 foregroundServiceType，且必须与
             UpdateDownloadWorker.createForegroundInfo() 里传的类型一致（dataSync），
             否则 startForeground 直接抛 MissingForegroundServiceTypeException。 -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- FileProvider for sharing images -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>