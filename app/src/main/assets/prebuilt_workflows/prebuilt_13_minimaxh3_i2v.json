{
 "name": "图生视频·MiniMaxH3",
 "description": "图生视频：给一张图，生成一段带画面与声音的视频。",
 "workflow_type": "ITV",
 "defaults": {
  "unet_name": "",
  "vae_name": "",
  "clip_name": "",
  "lora_name": "",
  "positive_prompt": "",
  "seed": 1,
  "aspect_ratio": "9:16 (Portrait Widescreen)",
  "megapixels": 0.4,
  "speed_mode": "4-step LoRA",
  "steps": 4,
  "lora_strength": 0.75
 },
 "nodes": {
  "127": {
   "class_type": "SamplerCustomAdvanced",
   "inputs": {
    "noise": [
     "131",
     0
    ],
    "guider": [
     "128",
     0
    ],
    "sampler": [
     "125",
     0
    ],
    "sigmas": [
     "126",
     0
    ],
    "latent_image": [
     "133",
     1
    ]
   }
  },
  "123": {
   "class_type": "VAEDecodeAudio",
   "inputs": {
    "samples": [
     "127",
     0
    ],
    "vae": [
     "122",
     0
    ]
   }
  },
  "188": {
   "class_type": "CreateVideo",
   "inputs": {
    "images": [
     "124",
     0
    ],
    "audio": [
     "123",
     0
    ],
    "fps": 24,
    "bit_depth": 8,
    "color_space": "sRGB"
   }
  },
  "131": {
   "class_type": "RandomNoise",
   "inputs": {
    "noise_seed": "{{seed}}"
   }
  },
  "128": {
   "class_type": "BasicGuider",
   "inputs": {
    "model": [
     "140",
     0
    ],
    "conditioning": [
     "133",
     0
    ]
   }
  },
  "115": {
   "class_type": "ResolutionSelector",
   "inputs": {
    "aspect_ratio": "{{aspect_ratio}}",
    "megapixels": "{{megapixels}}",
    "multiple": 32
   }
  },
  "126": {
   "class_type": "BasicScheduler",
   "inputs": {
    "model": [
     "129",
     0
    ],
    "scheduler": "simple",
    "steps": "{{steps}}",
    "denoise": 1
   }
  },
  "124": {
   "class_type": "VAEDecode",
   "inputs": {
    "samples": [
     "127",
     0
    ],
    "vae": [
     "121",
     0
    ]
   }
  },
  "189": {
   "class_type": "SaveVideo",
   "inputs": {
    "video": [
     "188",
     0
    ],
    "filename_prefix": "video/MiniMax_H3",
    "format": "auto",
    "format.codec": "auto",
    "codec": "auto"
   }
  },
  "340": {
   "class_type": "ImageResizeKJv2",
   "inputs": {
    "image": [
     "114",
     0
    ],
    "width": [
     "115",
     0
    ],
    "height": [
     "115",
     1
    ],
    "upscale_method": "lanczos",
    "keep_proportion": "crop",
    "pad_color": "0, 0, 0",
    "crop_position": "center",
    "divisible_by": 32,
    "device": "cpu"
   }
  },
  "125": {
   "class_type": "KSamplerSelect",
   "inputs": {
    "sampler_name": "res_multistep"
   }
  },
  "133": {
   "class_type": "MiniMaxH3ImageToVideo",
   "inputs": {
    "clip": [
     "130",
     0
    ],
    "vae": [
     "121",
     0
    ],
    "first_frame": [
     "340",
     0
    ],
    "prompt": "{{positive_prompt}}",
    "width": [
     "115",
     0
    ],
    "height": [
     "115",
     1
    ],
    "length": [
     "134",
     1
    ]
   }
  },
  "129": {
   "class_type": "UNETLoader",
   "inputs": {
    "unet_name": "{{unet_name}}",
    "weight_dtype": "default"
   }
  },
  "138": {
   "class_type": "MiniMaxH3MemoryEfficientSageAttentionPatch",
   "inputs": {
    "model": [
     "365",
     0
    ]
   }
  },
  "134": {
   "class_type": "ComfyMathExpression",
   "inputs": {
    "values.a": [
     "135",
     0
    ],
    "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
   }
  },
  "121": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": "{{vae_name}}"
   }
  },
  "122": {
   "class_type": "VAELoader",
   "inputs": {
    "vae_name": "minimax_h3\\minimax_h3_audio_vae_fp32.safetensors"
   }
  },
  "365": {
   "class_type": "TESpeedMiniMaxH3",
   "inputs": {
    "model": [
     "129",
     0
    ],
    "processing_control_value": 0.08,
    "processing_percent_1": 0.1,
    "processing_percent_2": 0.9,
    "mcs": 2,
    "device": "auto",
    "mode": "{{speed_mode}}"
   }
  },
  "135": {
   "class_type": "PrimitiveFloat",
   "inputs": {
    "value": 8
   }
  },
  "140": {
   "class_type": "LoraLoaderModelOnly",
   "inputs": {
    "model": [
     "138",
     0
    ],
    "lora_name": "{{lora_name}}",
    "strength_model": "{{lora_strength}}"
   }
  },
  "130": {
   "class_type": "CLIPLoader",
   "inputs": {
    "clip_name": "{{clip_name}}",
    "type": "minimax",
    "device": "default"
   }
  },
  "114": {
   "class_type": "LoadImage",
   "inputs": {
    "image": "{{image_filename}}",
    "upload": "image"
   }
  }
 }
}
